---
layout: base.njk
bodyClass: inner
---
<section class="page-hero"><div class="wrap"><h1>{{ heading or title }}</h1></div></section>
<div class="wrap content-wrap">
<article class="prose">{{ content | safe }}</article>
<ul class="cards">
{% set list = collections.storyList if listing == 'stories' else collections.blogList %}
{% for p in list %}
<li><a href="{{ p.url }}">{% set im = p.rawInput | firstImg %}{% if im %}<img src="{{ im | thumb }}" alt="" loading="lazy">{% endif %}<span class="t">{{ p.data.heading or p.data.title }}</span>{% if p.data.date %}<span class="d">{{ p.data.date | readableDate }}</span>{% endif %}</a></li>
{% endfor %}
</ul>
</div>
{% include "partials/cta.njk" %}
