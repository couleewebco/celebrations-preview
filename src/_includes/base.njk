<!doctype html>
<html lang="en" data-base="">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seo_title or title }}{% if not seo_title %} | {{ site.name }}{% endif %}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if site.noindex %}<meta name="robots" content="noindex, nofollow, noarchive">{% endif %}
<meta property="og:title" content="{{ seo_title or title }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
{% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
<link rel="icon" href="{{ site.favicon }}">
<link rel="apple-touch-icon" href="{{ site.favicon }}">
<meta name="theme-color" content="#0a0a0b">
<link rel="stylesheet" href="/assets/css/site.css?v=3">
<script src="/assets/js/site.js?v=1" defer></script>
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<nav class="mobile-bar" aria-label="Quick actions">
  <a href="tel:{{ site.phone_tel }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-3 2a11 11 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg><span>Call</span></a>
  <a href="{{ site.cta_primary.url }}" class="gold"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="14" r="6"/><path d="M9 4l3 4 3-4"/></svg><span>Tour</span></a>
  <a href="{{ site.cta_secondary.url }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><span>Dates</span></a>
</nav>
<div class="lb" id="lb" hidden aria-modal="true" role="dialog" aria-label="Photo viewer">
  <button class="lb-x" aria-label="Close">×</button><button class="lb-p" aria-label="Previous">‹</button>
  <img alt=""><button class="lb-n" aria-label="Next">›</button><div class="lb-c"></div>
</div>
</body>
</html>
