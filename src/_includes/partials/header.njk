<header class="site-header" id="top">
  <div class="topline"><a href="tel:{{ site.phone_tel }}">{{ site.phone }}</a><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
  <div class="bar">
    <a class="brand" href="/"><img src="{{ site.logo_white }}" alt="{{ site.name }} – La Crosse, WI wedding venue" width="180" height="68" loading="eager" decoding="async"></a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav"><span>Menu</span><i></i></button>
    <nav id="nav" aria-label="Main">
      <ul class="menu">{% set items = site.nav %}{% include "partials/nav-items.njk" %}</ul>
      <a class="btn gold nav-cta" href="{{ site.cta_primary.url }}">{{ site.cta_primary.label }}</a>
    </nav>
  </div>
</header>
